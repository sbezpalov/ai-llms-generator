{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "Командные настройки Claude Code для ai-llms-generator. Личные оверрайды — в settings.local.json (не коммитить).",
  "permissions": {
    "allow": ["Read", "Edit"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**.pem)",
      "Read(**.key)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.kube/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  }
}
